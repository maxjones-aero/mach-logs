# Python bytecode and tooling caches
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.matplotlib-cache/
*.egg-info/
build/
dist/
pytest-cache-files-*/

# Virtual environments and local configuration
.venv/
venv/
env/
.env
.env.*
!.env.example

# IDE and operating-system files
.idea/
.vscode/
.DS_Store
Thumbs.db
Desktop.ini

# Raw flight logs and generated media
*.bin
!tests/fixtures/empty.bin
*.mp4
out/*
!out/.gitkeep
